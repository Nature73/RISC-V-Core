`timescale 1 ps/ 1 ps

module riscv_soc_altera (
	CLOCK,
	BTN,
	SW,
	LED,
	uart_rx,
	uart_tx);
input 	CLOCK;
input 	[1:0] BTN;
input 	[9:0] SW;
output 	[9:0] LED;
input 	uart_rx;
output 	uart_tx;

